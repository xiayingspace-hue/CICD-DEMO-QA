API_BASE_URL=http://localhost:8080/defect-service
WEB_BASE_URL=http://localhost:5173
# 联调环境测试账号（密码默认 Test@1234）
# TEST_ACCOUNT_PASSWORD=Test@1234
# 直连联调库（TC-029 停用账号；REQ-002 状态脚本、DLP 脚本、种子缺陷）。不配置 DB_HOST 时依赖它们的用例自动跳过
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# REQ-002 TC-036/037：以 app.clock.fixed-instant 启动服务后，填入同一 instant（如 2030-06-15T15:59:59Z 或 2030-06-15T16:00:00Z）
# SERVER_FIXED_INSTANT=
